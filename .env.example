# Set locally in .env.local and in your hosting environment. Never commit real secrets.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
POSTGRES_URL=
# At least 32 cryptographically random characters; required for CMS sessions.
JWT_SECRET=
# One-time bootstrap: set only while provisioning a NEW admin; remove immediately afterward.
ADMIN_SETUP_TOKEN=
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=
# Optional configured ad client/slots; no live ads will render without these.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_INTRO=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_MIDDLE=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_END=
